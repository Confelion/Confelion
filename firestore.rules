rules_version = '2';

// ===============================================================
// Confelion Cloud Firestore Security Rules
// Designed for seamless compatibility with Confelion Apparel Platform
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authorization: checks verified emails, custom claims, or user profile role
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() in [
          'confelion@gmail.com',
          'admin@confelion.com',
          'admin.confelion@gmail.com'
        ] ||
        (request.auth.token != null && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ===============================================================
    // 1. PRODUCTS COLLECTION
    // Public read for storefront; write managed by Admin & stock updates
    // ===============================================================
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inventory', 'updated_at'])
      );
    }

    // ===============================================================
    // 2. STOREFRONT SETTINGS COLLECTION
    // Real-time hero banners, announcement bar, themes & footer settings
    // ===============================================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // 3. ORDERS COLLECTION
    // Guest & patron checkout processing and admin order management
    // ===============================================================
    match /orders/{orderId} {
      // Both guests and logged-in customers can place orders
      allow create: if true;

      // Customers can read their own orders; Admins can read all orders
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.user_id == request.auth.uid ||
          (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
        )
      );

      // Only administrators can edit order details, update status, or clear orders
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // 4. USERS COLLECTION (Patron Profiles)
    // Profile details, saved shipping addresses, and account metadata
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ===============================================================
    // 5. CARTS COLLECTION
    // Customer shopping cart persistence across sessions
    // ===============================================================
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ===============================================================
    // 6. VIP SUBSCRIBERS COLLECTION
    // Storefront footer email capture for VIP drops
    // ===============================================================
    match /vip_subscribers/{subscriberId} {
      // Any visitor can subscribe
      allow create, update: if true;
      // Only administrators can view or delete subscriber entries
      allow read, delete: if isAdmin();
    }
  }
}
