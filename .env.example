# =================================================================
# CONFELION BACKEND SERVER CONFIGURATION
# =================================================================
# Copy this file to .env and fill in real values
# NEVER commit the real .env file to Git
# =================================================================

PORT=3000
JWT_SECRET=change_this_to_a_strong_random_string

# -----------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY
# -----------------------------------------------------------------
RAZORPAY_KEY=rzp_test_XXXXXXXXXX
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# -----------------------------------------------------------------
# 1. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible)
# -----------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_DOMAIN=https://pub-XXXXX.r2.dev

CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://pub-XXXXX.r2.dev

# -----------------------------------------------------------------
# 2. RESEND TRANSACTIONAL EMAIL SERVICE
# -----------------------------------------------------------------
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=Confelion <orders@confelion.com>
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# -----------------------------------------------------------------
# 3. DELHIVERY ONE LOGISTICS & SHIPPING CONFIGURATION
# -----------------------------------------------------------------
D1_CLIENT_ID=your_delhivery_client_id
D1_CLIENT_SECRET=your_delhivery_client_secret
D1_AUTH_URL=https://ucp-auth.delhivery.com/facelessvoid
D1_REALM=your_delhivery_realm
D1_CLIENT_CMS=your_delhivery_cms_client_id
D1_MCP_URL=https://mcp-client.delhivery.com/mcp
D1_USER_EMAIL=your_delhivery_email
DELHIVERY_DEFAULT_WAREHOUSE=your_warehouse_name
DELHIVERY_DEFAULT_PINCODE=000000
DELHIVERY_COMPANY_ID=your_company_id

# -----------------------------------------------------------------
# 4. FIREBASE CLOUD FIRESTORE SERVICE ACCOUNT (Backend)
# -----------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------
# 5. FRONTEND VITE CLIENT-SIDE ENVIRONMENT VARIABLES (Vercel / Vite)
