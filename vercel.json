{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "confelion-frontend/dist",
  "rewrites": [
    {
      "source": "/api/products/:handle",
      "destination": "/api/products.js?handle=:handle"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
